<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title><%= title %></title>
    <meta name="theme-color" content="#FFFFFF">
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
    <%# Tipografía servida desde la tienda (no desde Google): llega antes y queda en caché entre páginas %>
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/aeris.css?v=<%= version %>">
    <%- include('partials/ajustar-titulos') %>
</head>
<body class="pagina-<%= pagina %>">
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <%- include('partials/nav') %>

    <main id="contenido">
        <%- body %>
    </main>

    <%- include('partials/pie') %>

    <%# Hoja del selector rápido (celular) y aviso "Agregado": los llena tienda.js %>
    <div class="capa" id="capa" hidden><div class="hoja" id="hoja" role="dialog" aria-modal="true" aria-label="Elegir color y talla"></div></div>
    <div id="avisoCaja" class="aviso-caja" role="status" aria-live="polite"></div>

    <script src="/js/core/contracts.js?v=<%= version %>"></script>
    <script src="/js/core/persistent-store.js?v=<%= version %>"></script>
    <script src="/js/core/bag-store.js?v=<%= version %>"></script>
    <script src="/js/core/wish-store.js?v=<%= version %>"></script>
    <script src="/js/core/pedidos-store.js?v=<%= version %>"></script>
    <script src="/js/ui/tienda.js?v=<%= version %>"></script>
    <%- defineContent('scripts') %>
</body>
</html>
